# Database Configuration
# Sử dụng container name khi app chạy trong Docker network
# Sử dụng localhost khi app chạy trực tiếp trên host
DB_HOST=payment-postgres  # hoặc localhost khi dev local
DB_PORT=5432              # 5432 trong Docker network, 5433 từ host
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=payment_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300

# Kafka Configuration
# broker:29092 trong Docker network, localhost:9092 từ host
KAFKA_BROKER=broker:29092  # hoặc localhost:9092 khi dev local
KAFKA_PRODUCER_TOPIC=transaction_create
KAFKA_CONSUMER_TOPIC=consumer_topic
KAFKA_CONSUMER_GROUP_ID=consumer_group
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=5
KAFKA_PRODUCER_MAX_IN_FLIGHT=5
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=true

# AKHQ Configuration
AKHQ_PORT=8080
