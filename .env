#Environment variables
PORT=8085

#DB_CONFIGURATION
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=payment_db

#POSTGRESQL DOCKER
POSTGRES_DB=payment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

#CONNECTION_POOL
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=2
DB_MAX_IDLE_CONNECTIONS=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_MAX_LIFETIME=2000

#UTILS
POLLING_MAX_TIMEOUT=10000

#KAFKA_CONFIGURATION
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

#PRODUCER
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=10
KAFKA_PRODUCER_MAX_IN_FLIGHT_REQUESTS=5
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
KAFKA_PRODUCER_TOPIC=transactions

#CONSUMER
KAFKA_CONSUMER_GROUP_ID=transaction_processor_group
KAFKA_CONSUMER_TOPIC=transaction-create
KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=false
KAFKA_CONSUMER_AUTO_OFFSET_RESET=latest
KAFKA_CONSUMER_SESSION_TIMEOUT=60000
KAFKA_CONSUMER_HEARTBEAT_INTERVAL=20000
KAFKA_CONSUMER_ISOLATION_LEVEL=read_committed
